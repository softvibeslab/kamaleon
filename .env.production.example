# ════════════════════════════════════════════════════════════════
#                    Production Environment Variables
#                    Kamaleon Ecosystem
# ════════════════════════════════════════════════════════════════

# Database - CHANGE THESE!
POSTGRES_USER=kamaleon
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123!
POSTGRES_DB=kamaleon

# JWT - CHANGE THIS! (generate with: openssl rand -base64 64)
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# CORS - Set your actual domains
CORS_ORIGINS=https://dashboard.kamaleon.com,https://kamaleon.com

# Frontend API URL
VITE_API_URL=https://api.kamaleon.com
